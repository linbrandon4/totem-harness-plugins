{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "totem": {
      "type": "streamable-http",
      "url": "https://totemlayer.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://totemlayer.com/mcp",
            "baseScopes": ["totem:network"]
          }
        }
      }
    }
  }
}
